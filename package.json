{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "start": "turbo run start",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "preinstall": "npx only-allow pnpm",
    "schema:generate": "pnpm --filter=web schema:generate",
    "db:generate": "pnpm --filter=web db:generate",
    "db:migrate": "pnpm --filter=web db:migrate",
    "db:seed": "pnpm --filter=web db:seed",
    "db:reset": "pnpm --filter=web db:reset",
    "db:studio": "pnpm --filter=web db:studio",
    "deploy-discord:dev": "pnpm --filter=bot deploy:dev",
    "deploy-discord:prod": "pnpm --filter=bot deploy:prod",
    "format": "prettier --write .",
    "format-check": "prettier --check ."
  },
  "devDependencies": {
    "@turbo/gen": "^2.0.9",
    "@types/node": "20.14.11",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.7.0",
    "prettier": "^3.3.3",
    "turbo": "^2.0.9"
  },
  "packageManager": "pnpm@8.3.1+sha512.d264f6640bf4f09de7cfcc547568515bcf0613cf485a03e8ff16616fa69c4172b6f9a0a2925ee44fb060df565c9c9a8eaf061749e77af318cb77f6684a7051f3",
  "name": "hackkit",
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "prettier-plugin-tailwindcss": "^0.6.5"
  }
}
