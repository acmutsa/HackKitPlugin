{
  "name": "@hackkit/cli",
  "version": "0.0.0",
  "description": "HackKit CLI",
  "type": "module",
  "bin": {
    "hackkit": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hackkit/config": "workspace:*",
    "@hackkit/core": "workspace:*",
    "commander": "^12.1.0",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "20.14.11",
    "tsdown": "^0.22.0",
    "typescript": "5.5.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "private": true
}
