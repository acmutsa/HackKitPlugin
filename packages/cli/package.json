{
  "name": "@hackkit/cli",
  "version": "0.0.0",
  "description": "HackKit CLI",
  "type": "module",
  "bin": {
    "hackkit": "./bin/hackkit.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hackkit/config": "workspace:*",
    "@hackkit/core": "workspace:*",
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "jiti": "^2.4.2",
    "@mikro-orm/core": "7.2.1",
    "@mikro-orm/migrations": "7.2.1",
    "prettier": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsdown": "^0.22.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "@mikro-orm/sqlite": "7.2.1"
  },
  "license": "MIT",
  "private": true
}
