# Copy this file to .env. Keep real secrets in ignored environment files.
# Local development works with an empty .env using these defaults.
DATABASE_URL=file:.data/web.db
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production: set a unique secret with at least 32 characters.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Required for full-template production: replace NEXT_PUBLIC_APP_URL with your
# deployment URL, configure persistent database storage, and set the S3 and
# Discord variables below. Production requires S3 even when developing locally
# with filesystem uploads. Set either the Discord participant role ID or name.
# HACKKIT_BLOB_ADAPTER=s3
# HACKKIT_S3_BUCKET=
# HACKKIT_S3_REGION=us-east-1
# HACKKIT_S3_ACCESS_KEY_ID=
# HACKKIT_S3_SECRET_ACCESS_KEY=
# DISCORD_GUILD_ID=
# DISCORD_BOT_API_URL=
# DISCORD_INTERNAL_AUTH_KEY=
# DISCORD_PARTICIPANT_ROLE_ID=
# DISCORD_PARTICIPANT_ROLE_NAME=

# Optional: auth URL defaults to NEXT_PUBLIC_APP_URL.
# BETTER_AUTH_URL=http://localhost:3000
# Optional: comma-separated additional trusted origins.
# BETTER_AUTH_TRUSTED_ORIGINS=https://another-origin.example.com

# Optional: database dialect is inferred from DATABASE_URL. Set libsql explicitly
# for a local libSQL file; supported values are sqlite, libsql, postgresql, mysql.
# HACKKIT_DATABASE_DIALECT=sqlite
# Optional: required only for authenticated remote libSQL / Turso databases.
# TURSO_AUTH_TOKEN=

# Optional: local development storage defaults to these values.
# HACKKIT_BLOB_ADAPTER=local
# HACKKIT_LOCAL_BLOB_BASE_DIR=.data/uploads
# Optional: custom endpoint for S3-compatible stores such as R2.
# HACKKIT_S3_ENDPOINT=
# Optional: verification links default to NEXT_PUBLIC_APP_URL.
# DISCORD_VERIFICATION_BASE_URL=http://localhost:3000

# Optional: OAuth providers. Enable a provider by setting both its ID and secret.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: email defaults to none. For Resend, configure:
# HACKKIT_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# HACKKIT_EMAIL_FROM="HackKit <notifications@example.com>"
# HACKKIT_EMAIL_REPLY_TO=

# Optional: use SMTP instead of Resend by configuring:
# HACKKIT_EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# HACKKIT_EMAIL_FROM="HackKit <notifications@example.com>"
# HACKKIT_EMAIL_REPLY_TO=

# Optional: migration history directory, relative to this template or absolute.
# HACKKIT_MIGRATIONS_PATH=db/migrations/sqlite
