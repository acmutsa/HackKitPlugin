# Copy this file to .env. Keep real secrets in ignored environment files.
# Local development works with an empty .env using these defaults.
DATABASE_URL=file:.data/web.db
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production: set a unique secret with at least 32 characters.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Production: replace NEXT_PUBLIC_APP_URL with your deployment URL and use
# persistent disk paths for DATABASE_URL and HACKKIT_LOCAL_BLOB_BASE_DIR.

# Optional: auth URL defaults to NEXT_PUBLIC_APP_URL.
# BETTER_AUTH_URL=http://localhost:3000
# Optional: comma-separated additional trusted origins.
# BETTER_AUTH_TRUSTED_ORIGINS=https://another-origin.example.com
# Optional: local upload directory, relative to this template or absolute.
# HACKKIT_LOCAL_BLOB_BASE_DIR=.data/uploads
