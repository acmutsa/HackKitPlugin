{
  "name": "@hackkit/demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "plugin:sync": "hackkit plugin sync",
    "db:generate": "node scripts/db.mjs generate",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "node scripts/db.mjs seed",
    "db:reset": "node scripts/db.mjs reset",
    "sync": "pnpm plugin:sync",
    "dev": "node scripts/compile-orm.mjs && vite dev --port 3001",
    "build": "node scripts/build.mjs",
    "verify": "pnpm sync && pnpm typecheck && pnpm build",
    "start": "vite preview --port 3001",
    "typecheck": "pnpm orm:compile && tsc -p tsconfig.typecheck.json --noEmit",
    "db:status": "node scripts/db.mjs status",
    "db:check": "node scripts/db.mjs check",
    "db:rollback": "node scripts/db.mjs rollback",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "cf:types": "wrangler types --include-runtime=false worker/env.d.ts",
    "test:smoke": "playwright test",
    "orm:compile": "node scripts/compile-orm.mjs",
    "db:demo": "node scripts/seed.mjs",
    "test:database": "node --test scripts/test-database.mjs"
  },
  "dependencies": {
    "@hackkit/cli": "workspace:*",
    "@hackkit/config": "workspace:*",
    "@hackkit/core": "workspace:*",
    "@hackkit/next": "workspace:*",
    "@hackkit/plugin-teams": "workspace:*",
    "@hackkit/ui": "workspace:*",
    "better-auth": "1.7.6",
    "next": "14.2.35",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^1.5.0",
    "typescript": "5.9.3",
    "@mikro-orm/migrations": "7.2.1",
    "@mikro-orm/core": "7.2.1",
    "jiti": "2.4.2",
    "@next/env": "14.2.35",
    "@libsql/client": "0.17.4",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.2.1",
    "@mikro-orm/sql": "7.2.1",
    "@libsql/kysely-libsql": "0.4.1",
    "kysely": "0.29.6",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "tailwindcss-animate": "1.0.7",
    "wrangler": "4.151.3",
    "@cloudflare/workers-types": "5.20261019.1",
    "@playwright/test": "1.64.1",
    "vite": "8.3.4",
    "@cloudflare/vite-plugin": "1.64.0",
    "@vitejs/plugin-rsc": "0.5.38",
    "@vitejs/plugin-react": "6.0.1",
    "@mikro-orm/cli": "7.2.1",
    "dotenv": "16.6.1"
  }
}
