{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "plugin:sync": "hackkit plugin sync",
    "auth:schema": "auth generate --config better-auth.config.ts --output db/schema/auth.ts --yes",
    "schema:generate": "pnpm auth:schema",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "bash scripts/db-reset.sh",
    "sync": "pnpm plugin:sync",
    "predev": "turbo run build --filter=web^...",
    "dev": "next dev -p 3000",
    "build": "next build",
    "verify": "pnpm sync && pnpm typecheck && pnpm build",
    "start": "next start",
    "db:studio": "drizzle-kit studio",
    "studio": "pnpm db:studio",
		"typecheck": "pnpm --filter @hackkit/cli build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hackkit/auth-better-auth": "workspace:*",
    "@hackkit/blob-local": "workspace:*",
    "@hackkit/blob-s3": "workspace:*",
    "@hackkit/cli": "workspace:*",
    "@hackkit/config": "workspace:*",
    "@hackkit/core": "workspace:*",
    "@hackkit/plugin-discord": "workspace:*",
    "@hackkit/plugin-notifications-email": "workspace:*",
    "@hackkit/plugin-teams": "workspace:*",
    "@hackkit/ui": "workspace:*",
    "@libsql/client": "^0.14.0",
    "better-auth": "1.6.11",
    "drizzle-orm": "^0.45.2",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "^1.5.0",
    "typescript": "5.5.3"
  },
  "devDependencies": {
    "@types/node": "20.14.11",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "auth": "1.6.11",
    "drizzle-kit": "^0.31.4",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "tailwindcss-animate": "1.0.7",
    "vitest": "^3.2.4"
  }
}
